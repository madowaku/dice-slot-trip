msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "TILE_HELP_EVENT_TITLE"
msgstr "CAIRO EVENT"

msgid "TILE_HELP_EVENT_BODY"
msgstr "An encounter changes the course of your hourglass journey."

msgid "TILE_HELP_ITEM_TITLE"
msgstr "ITEM FOUND"

msgid "TILE_HELP_ITEM_BODY"
msgstr "Gain a useful travel item. Check it in the Item menu."

msgid "TILE_HELP_COIN_TITLE"
msgstr "COINS FOUND"

msgid "TILE_HELP_COIN_BODY"
msgstr "Gain a coin. Spend coins on items and boss support."

msgid "TILE_HELP_REST_TITLE"
msgstr "TAKE A REST"

msgid "TILE_HELP_REST_BODY"
msgstr "♥ Recover 1 heart."

msgid "TILE_HELP_RISK_TITLE"
msgstr "DANGER ZONE"

msgid "TILE_HELP_RISK_BODY"
msgstr "⚠ Lose 1 heart. Shortcuts alternate RISK and REST."

msgid "TILE_HELP_WARP_TITLE"
msgstr "WARP POINT"

msgid "TILE_HELP_WARP_BODY"
msgstr "An entrance to another route. In a ring, it can lead you toward the exit."

msgid "TILE_HELP_TAP_TO_CLOSE"
msgstr "Tap anywhere to continue"

msgid "RULES_TITLE"
msgstr "How to play"

msgid "RULES_MOVE"
msgstr "Move"

msgid "RULES_SLOT"
msgstr "Slots"

msgid "RULES_HP"
msgstr "HP / Tools"

msgid "RULES_CLOSE"
msgstr "Back to menu"

msgid "RULES_MOVE_0_TITLE"
msgstr "1. Roll, then tap again"

msgid "RULES_MOVE_0_BODY"
msgstr "Tap Roll, then tap again to choose the number."

msgid "RULES_MOVE_1_TITLE"
msgstr "2. Move and explore"

msgid "RULES_MOVE_1_BODY"
msgstr "Each space traveled earns one point. Landing spaces can give you coins or items."

msgid "RULES_MOVE_2_TITLE"
msgstr "3. Three rolls make a slot"

msgid "RULES_MOVE_2_BODY"
msgstr "Each roll fills one slot. After three rolls, the combination is scored. Face the Sphinx ahead!"

msgid "RULES_SLOT_0_TITLE"
msgstr "2 · 2 · 5   Pair"

msgid "RULES_SLOT_0_BODY"
msgstr "Two matching numbers → +1 coin"

msgid "RULES_SLOT_1_TITLE"
msgstr "1 · 2 · 3   Straight"

msgid "RULES_SLOT_1_BODY"
msgstr "In order, rising or falling by one → +3 coins"

msgid "RULES_SLOT_2_TITLE"
msgstr "3 · 3 · 3   Triple"

msgid "RULES_SLOT_2_BODY"
msgstr "Three matching numbers → +5 coins"

msgid "RULES_SLOT_3_TITLE"
msgstr "Spend your coins"

msgid "RULES_SLOT_3_BODY"
msgstr "Other combinations give no reward. Use coins from the Coin button below. These rewards apply to the normal journey."

msgid "RULES_HP_0_TITLE"
msgstr "Risk and rest"

msgid "RULES_HP_0_BODY"
msgstr "Risk: −1 HP. Rest: +1 HP. Resting at full HP adds one skill charge."

msgid "RULES_HP_1_TITLE"
msgstr "When HP reaches zero"

msgid "RULES_HP_1_BODY"
msgstr "Use one remaining revive to return with full HP. If no revives remain, the journey ends."

msgid "RULES_HP_2_TITLE"
msgstr "Items and skills"

msgid "RULES_HP_2_BODY"
msgstr "Use collected tools from Items. A full skill gauge lets you choose your next number."

msgid "THREE_ROLL_ONBOARDING_TITLE"
msgstr "ROLL → STOP → MOVE"

msgid "THREE_ROLL_ONBOARDING_BODY"
msgstr "Tap Roll. Tap again to stop the die.\nYour cat moves that many spaces.\nThree rolls make one slot combination!\n\nExample: 2 · 2 · 5 → Pair, +1 coin"

msgid "THREE_ROLL_ONBOARDING_CTA"
msgstr "LET'S ROLL"

msgid "JOURNEY_INTRO_TITLE"
msgstr "SET OUT FOR THE SPHINX"

msgid "JOURNEY_INTRO_BODY"
msgstr "Explore Cairo and face the boss ahead!\nEach space traveled earns one point.\n\nRisk: −1 HP. Rest: +1 HP.\nOut of HP? Revive, or end if none remain."

msgid "JOURNEY_INTRO_CTA"
msgstr "NEXT — HOW TO ROLL"

msgid "FIRST_ROLL_START"
msgstr "Tap Roll to begin"

msgid "FIRST_ROLL_STOP"
msgstr "Tap again to choose your number"

msgid "FIRST_ROLL_SECOND"
msgstr "Two more rolls complete your slot"

msgid "FIRST_ROLL_THIRD"
msgstr "One more roll completes your slot"

msgid "TRAVEL_MENU_BUTTON"
msgstr "MENU"

msgid "TRAVEL_MENU_TITLE"
msgstr "TRAVEL MENU"

msgid "TRAVEL_MENU_DETAIL"
msgstr "Journey paused"

msgid "TRAVEL_MENU_CONTINUE"
msgstr "Continue Journey"

msgid "TRAVEL_MENU_EXIT"
msgstr "Return to Stage Select"

msgid "LOOP_EXIT_DISTANCE"
msgstr "%d to EXIT"

msgid "LOOP_RESCUE_PROGRESS"
msgstr "Rescue %d / %d laps"

msgid "LOOP_RESCUE_TOAST"
msgstr "The hourglass guided you out on the third lap"

msgid "VICTORY_KICKER"
msgstr "JOURNEY COMPLETE"

msgid "DEFEAT_KICKER"
msgstr "JOURNEY RECORD"

msgid "VICTORY_TITLE"
msgstr "ROUTE CLEARED"

msgid "DEFEAT_TITLE"
msgstr "SPHINX WINS"

msgid "VICTORY_SCORE"
msgstr "SPACES TRAVELLED %s"

msgid "VICTORY_MISSIONS"
msgstr "MISSION %d / %d"

msgid "VICTORY_ALL_MISSIONS"
msgstr "ALL MISSIONS COMPLETE"

msgid "VICTORY_NEXT"
msgstr "NEXT JOURNEY"

msgid "EVENT_MARKET_HAWKER_TITLE"
msgstr "MARKET HAWKER"
msgid "EVENT_MARKET_HAWKER_FIRST"
msgstr "A lively market hawker calls out, holding something bright in the sun."
msgid "EVENT_MARKET_HAWKER_REPEAT"
msgstr "The familiar hawker spots you and waves just as cheerfully as before."
msgid "EVENT_NILE_TAILWIND_TITLE"
msgstr "NILE TAILWIND"
msgid "EVENT_NILE_TAILWIND_FIRST"
msgstr "A welcome tailwind fills the sail and carries your spirits along the Nile."
msgid "EVENT_NILE_TAILWIND_REPEAT"
msgstr "Once again, the Nile wind fills the sail and lightens your step."
msgid "EVENT_RUIN_WHISPER_TITLE"
msgstr "WHISPERING RUINS"
msgid "EVENT_RUIN_WHISPER_FIRST"
msgstr "Blue light unfurls from the ruin wall, whispering a secret of the hourglass."
msgid "EVENT_RUIN_WHISPER_REPEAT"
msgstr "The blue light stirs again, carrying a whisper you remember."
msgid "EVENT_FERRY_OFFER_TITLE"
msgstr "FERRY OFFER"
msgid "EVENT_FERRY_OFFER_FIRST"
msgstr "A cheerful crocodile boatman invites you aboard his Nile ferry."
msgid "EVENT_FERRY_OFFER_REPEAT"
msgstr "The familiar boatman waves cheerfully from his ferry once again."
msgid "EVENT_DISCOVERY_SCORE"
msgstr "FIRST DISCOVERY!"
msgid "EVENT_CONTINUE_CTA"
msgstr "CONTINUE JOURNEY"

msgid "MISSION_PROGRESS_REMAINING"
msgstr "%d/%d · %d left"

msgid "MISSION_NEXT_LAP_HINT"
msgstr "A new mission awaits next lap"

msgid "MISSION_ONE_MORE"
msgstr "One more to clear! COIN +%d"
