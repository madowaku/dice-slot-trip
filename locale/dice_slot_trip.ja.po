msgid ""
msgstr ""
"Language: ja\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "TILE_HELP_EVENT_TITLE"
msgstr "カイロ EVENT"

msgid "TILE_HELP_EVENT_BODY"
msgstr "街の出来事が、砂時計の旅に小さな変化をもたらす。"

msgid "TILE_HELP_ITEM_TITLE"
msgstr "旅道具を発見"

msgid "TILE_HELP_ITEM_BODY"
msgstr "旅を助ける道具を入手する。アイテム欄から確認できる。"

msgid "TILE_HELP_COIN_TITLE"
msgstr "コインを発見"

msgid "TILE_HELP_COIN_BODY"
msgstr "コインを獲得。アイテムやボス戦の支援に使える。"

msgid "TILE_HELP_REST_TITLE"
msgstr "ひとやすみ"

msgid "TILE_HELP_REST_BODY"
msgstr "♥ ハートを1回復する。"

msgid "TILE_HELP_RISK_TITLE"
msgstr "危険地帯"

msgid "TILE_HELP_RISK_BODY"
msgstr "⚠ ハートが1減る。近道はRISKとRESTが交互に並ぶ。"

msgid "TILE_HELP_WARP_TITLE"
msgstr "ワープ地点"

msgid "TILE_HELP_WARP_BODY"
msgstr "別ルートへ移動する入口。円環では出口へ向かう道を選べる。"

msgid "TILE_HELP_TAP_TO_CLOSE"
msgstr "画面をタップして旅を続ける"

msgid "RULES_TITLE"
msgstr "遊び方"

msgid "RULES_MOVE"
msgstr "操作"

msgid "RULES_SLOT"
msgstr "役とコイン"

msgid "RULES_HP"
msgstr "HP・道具"

msgid "RULES_CLOSE"
msgstr "メニューへ戻る"

msgid "RULES_MOVE_0_TITLE"
msgstr "① 振って、もう一度で止める"

msgid "RULES_MOVE_0_BODY"
msgstr "「振る」をタップし、もう一度タップすると出目が決まります。"

msgid "RULES_MOVE_1_TITLE"
msgstr "② 出た目の数だけ進む"

msgid "RULES_MOVE_1_BODY"
msgstr "進んだ1マスが1ポイント。止まったマスでコインやアイテムを見つけます。"

msgid "RULES_MOVE_2_TITLE"
msgstr "③ 3投でスロットが完成"

msgid "RULES_MOVE_2_BODY"
msgstr "1投ずつ数字が並び、3つそろうと役が決まります。旅の先ではスフィンクスと勝負！"

msgid "RULES_SLOT_0_TITLE"
msgstr "2・2・5　ペア"

msgid "RULES_SLOT_0_BODY"
msgstr "同じ数字が2つ → コイン +1"

msgid "RULES_SLOT_1_TITLE"
msgstr "1・2・3　ストレート"

msgid "RULES_SLOT_1_BODY"
msgstr "出た順に数字が1ずつ増減 → コイン +3"

msgid "RULES_SLOT_2_TITLE"
msgstr "3・3・3　トリプル"

msgid "RULES_SLOT_2_BODY"
msgstr "同じ数字が3つ → コイン +5"

msgid "RULES_SLOT_3_TITLE"
msgstr "コインの使い方"

msgid "RULES_SLOT_3_BODY"
msgstr "役なしは報酬なし。コインは画面下の「コイン」から使えます。ここに載せた報酬は通常の旅のものです。"

msgid "RULES_HP_0_TITLE"
msgstr "危険で減り、休憩で回復"

msgid "RULES_HP_0_BODY"
msgstr "危険マスでHP −1、休憩マスでHP +1。HP満タンで休憩すると、スキルが1増えます。"

msgid "RULES_HP_1_TITLE"
msgstr "HPが0になったら"

msgid "RULES_HP_1_BODY"
msgstr "復活が残っていれば1回使い、HP満タンで再出発。残っていなければ旅は終了です。"

msgid "RULES_HP_2_TITLE"
msgstr "アイテムとスキル"

msgid "RULES_HP_2_BODY"
msgstr "拾った道具は「アイテム」から。スキルが満タンになると、次の出目を選べます。"

msgid "THREE_ROLL_ONBOARDING_TITLE"
msgstr "振る → 止める → 進む"

msgid "THREE_ROLL_ONBOARDING_BODY"
msgstr "「振る」をタップ。もう一度で止めよう。\n出た目の数だけ、猫が進みます。\n3投分の数字で、スロットの役が決定！\n\n例：2・2・5 → ペアでコイン +1"

msgid "THREE_ROLL_ONBOARDING_CTA"
msgstr "さっそく振ってみよう"

msgid "JOURNEY_INTRO_TITLE"
msgstr "スフィンクスを目指そう"

msgid "JOURNEY_INTRO_BODY"
msgstr "カイロをめぐり、旅の先でボスと勝負！\n進んだ1マスが、1ポイントになります。\n\n危険マスでHP −1、休憩マスでHP +1。\nHP0でも、復活が残っていれば再出発！"

msgid "JOURNEY_INTRO_CTA"
msgstr "次へ　サイコロの遊び方"

msgid "FIRST_ROLL_START"
msgstr "「振る」をタップしてスタート"

msgid "FIRST_ROLL_STOP"
msgstr "もう一度タップして、出目を決めよう"

msgid "FIRST_ROLL_SECOND"
msgstr "あと2投で、スロットの役が決まる"

msgid "FIRST_ROLL_THIRD"
msgstr "次の1投で、スロットの役が決まる"

msgid "TRAVEL_MENU_BUTTON"
msgstr "メニュー"

msgid "TRAVEL_MENU_TITLE"
msgstr "旅のメニュー"

msgid "TRAVEL_MENU_DETAIL"
msgstr "旅を中断しています"

msgid "TRAVEL_MENU_CONTINUE"
msgstr "旅を続ける"

msgid "TRAVEL_MENU_EXIT"
msgstr "ステージ選択へ戻る"

msgid "LOOP_EXIT_DISTANCE"
msgstr "EXITまで %d"

msgid "LOOP_RESCUE_PROGRESS"
msgstr "救済 %d / %d周"

msgid "LOOP_RESCUE_TOAST"
msgstr "砂時計の導きで、3周目の出口から本線へ戻った"

msgid "VICTORY_KICKER"
msgstr "旅のゴール！"

msgid "DEFEAT_KICKER"
msgstr "レース終了"

msgid "VICTORY_TITLE"
msgstr "スフィンクスに勝った！"

msgid "DEFEAT_TITLE"
msgstr "あと一歩！"

msgid "VICTORY_SCORE"
msgstr "旅したマス %s"

msgid "VICTORY_MISSIONS"
msgstr "ミッション達成 %d / %d"

msgid "VICTORY_ALL_MISSIONS"
msgstr "ミッション全達成！"

msgid "VICTORY_NEXT"
msgstr "次の旅へ"

msgid "EVENT_MARKET_HAWKER_TITLE"
msgstr "市場の呼び込み"
msgid "EVENT_MARKET_HAWKER_FIRST"
msgstr "市場の呼び込みが、きらめく品を掲げて元気よく声をかけてきた。"
msgid "EVENT_MARKET_HAWKER_REPEAT"
msgstr "顔なじみの呼び込みが、今日もにぎやかに手を振っている。"
msgid "EVENT_NILE_TAILWIND_TITLE"
msgstr "ナイルの追い風"
msgid "EVENT_NILE_TAILWIND_FIRST"
msgstr "ナイルの帆が大きくふくらみ、心地よい追い風が旅人を包んだ。"
msgid "EVENT_NILE_TAILWIND_REPEAT"
msgstr "今日もナイルの風が帆を押し、旅の足取りを軽くした。"
msgid "EVENT_RUIN_WHISPER_TITLE"
msgstr "遺跡のささやき"
msgid "EVENT_RUIN_WHISPER_FIRST"
msgstr "遺跡の壁画から青い光がほどけ、砂時計の秘密をそっとささやいた。"
msgid "EVENT_RUIN_WHISPER_REPEAT"
msgstr "青い光がふたたび揺れ、聞き覚えのあるささやきが響いた。"
msgid "EVENT_FERRY_OFFER_TITLE"
msgstr "渡し船の客引き"
msgid "EVENT_FERRY_OFFER_FIRST"
msgstr "ワニの船頭が、ナイルを渡る舟へ陽気に招いてきた。"
msgid "EVENT_FERRY_OFFER_REPEAT"
msgstr "顔なじみの船頭が、舟の上からまた陽気に手を振っている。"
msgid "EVENT_DISCOVERY_SCORE"
msgstr "初めて発見！"
msgid "EVENT_CONTINUE_CTA"
msgstr "旅を続ける"

msgid "MISSION_PROGRESS_REMAINING"
msgstr "進捗 %d/%d　あと%d"

msgid "MISSION_NEXT_LAP_HINT"
msgstr "次の周で、新しいミッションへ"

msgid "MISSION_ONE_MORE"
msgstr "あと1でミッション達成！ COIN +%d"
